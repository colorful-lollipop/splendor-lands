.stage {
  position: relative;
  height: 100vh;
  /* 自定义导航栏时，顶部要给右上角胶囊按钮留出空间。 */
  padding: calc(env(safe-area-inset-top) + 96rpx) 44rpx calc(env(safe-area-inset-bottom) + 34rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #0a0704;
}

.stage::after {
  content: "";
  position: absolute;
  inset: 20rpx;
  border: 1rpx solid rgba(226, 184, 108, 0.28);
  border-radius: 6rpx;
  pointer-events: none;
  z-index: 4;
}

.backdrop {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: scale(1.015);
}

.veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(5, 3, 2, 0.62) 0%,
    rgba(5, 3, 2, 0.1) 26%,
    rgba(5, 3, 2, 0.24) 48%,
    rgba(5, 3, 2, 0.9) 70%,
    #0a0704 100%
  );
}

.glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(90% 45% at 50% 100%, rgba(196, 139, 55, 0.18), transparent 70%);
  pointer-events: none;
}

.topbar {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gem {
  color: #e8c06a;
  font-size: 26rpx;
  text-shadow: 0 0 16rpx rgba(232, 192, 106, 0.7);
}

.brand-name {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24rpx;
  letter-spacing: 0.34em;
  color: #f0dfb8;
}

.edition {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: rgba(236, 220, 187, 0.62);
}

.content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 560px;
  margin: auto auto 0;
  padding-top: 120rpx;
}

.kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.26em;
  color: #d9b369;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.95);
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: min(108rpx, 68px);
  line-height: 1.05;
  letter-spacing: 0.08em;
  font-weight: 600;
  color: #f6e6bd;
  background: linear-gradient(180deg, #fff8e2 4%, #f0d79e 38%, #c9993f 72%, #f4e2b2 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 6rpx 20rpx rgba(0, 0, 0, 0.65));
}

.subtitle {
  display: block;
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  letter-spacing: 0.04em;
  color: rgba(236, 220, 187, 0.82);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.9);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.chip {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(224, 180, 104, 0.32);
  border-radius: 999rpx;
  background: rgba(10, 7, 4, 0.42);
  color: rgba(233, 213, 172, 0.78);
  font-size: 20rpx;
  letter-spacing: 0.08em;
}

.enter {
  width: 100%;
  min-height: 112rpx;
  margin-top: 40rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: linear-gradient(180deg, #fff0c4 0%, #e3bc6b 42%, #b8873a 100%);
  box-shadow:
    0 0 0 1rpx rgba(255, 240, 196, 0.65) inset,
    0 0 0 6rpx rgba(10, 7, 4, 0.5),
    0 0 0 7rpx rgba(214, 170, 94, 0.3),
    0 18rpx 44rpx rgba(0, 0, 0, 0.55);
  transition: transform 0.15s ease, filter 0.15s ease;
}

.enter-hover {
  transform: translateY(1rpx) scale(0.992);
  filter: brightness(0.94);
}

.enter-main {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.22em;
  color: #2b1905;
}

.enter-sub {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 15rpx;
  letter-spacing: 0.32em;
  color: rgba(43, 25, 5, 0.62);
}

.hint {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 19rpx;
  letter-spacing: 0.06em;
  color: rgba(165, 145, 109, 0.72);
}

.foot {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
  max-width: 560px;
  margin: 30rpx auto 0;
  text-align: center;
  font-size: 17rpx;
  letter-spacing: 0.04em;
  color: rgba(109, 92, 68, 0.9);
}

@media (min-height: 900px) {
  .content {
    padding-top: 220rpx;
  }
  .title {
    font-size: min(120rpx, 76px);
  }
}